[Unit]
Description=Cloud Sandbox MCP Server
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/cloud-sandbox-mcp
EnvironmentFile=/opt/cloud-sandbox-mcp/.env
ExecStart=/usr/bin/node /opt/cloud-sandbox-mcp/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloud-sandbox-mcp

[Install]
WantedBy=multi-user.target
