{
  "manifest_version": 3,
  "name": "Sandbox V3 Toyota Teams DOM",
  "version": "0.1.0",
  "description": "Typed DOM access to Teams in this browser profile for authorized Sandbox V3 sessions.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://teams.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Sandbox V3 Teams DOM"
  }
}
