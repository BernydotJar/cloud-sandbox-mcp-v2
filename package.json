{
  "name": "cloud-sandbox-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Remote MCP server that gives ChatGPT a persistent, VM-like persistent agent workstation with nested Docker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run validate:lock && npm run lint && npm run typecheck && npm test && npm run test:mac && npm run test:task-scoped && npm run test:browser:policy && npm run test:browser:reinforcement && npm run test:ops:storage && npm run test:ops:ssd-migration && npm run test:mac:isolated && npm run test:mac:same-background && npm run test:cli:v3 && npm run test:gemini:mcp && npm run build",
    "validate:lock": "node scripts/validate-lockfile.mjs",
    "test:mac": "node --test mac-host/*.node-test.mjs mac-host/browser-runtime/*.node-test.mjs deploy/browser-channel-providers/*.node-test.mjs deploy/dedicated-chrome/*.node-test.mjs deploy/bridge-toast/*.node-test.mjs scripts/terminal-sandbox/*.node-test.mjs deploy/allowed-origins/*.node-test.mjs deploy/session-budget/patch.node-test.mjs deploy/background-ax/*.node-test.mjs mac-host/browser-dom/*.node-test.mjs deploy/browser-dom/*.node-test.mjs",
    "test:browser:e2e": "CUA_BROWSER_E2E=1 node mac-host/browser-runtime/browser-e2e.mjs",
    "test:qa:offscreen": "CUA_OFFSCREEN_QA=1 node scripts/offscreen-qa/smoke.mjs",
    "test:release:sim": "python3 deploy/browser-auto/test-install-sim.py && python3 deploy/browser-hardening/test-install-sim.py",
    "test:browser:auto:installer": "python3 deploy/browser-auto/test-install-sim.py",
    "verify:v2": "npm run verify && npm run test:browser:e2e && npm run test:qa:offscreen && npm run test:release:sim && npm run test:browser:dom:ckeditor",
    "test:engine-routing": "node --test mac-host/engine-routing.node-test.mjs scripts/browser-automation/engine-router.node-test.mjs",
    "test:browser:policy": "node --test mac-host/engine-routing.node-test.mjs scripts/browser-automation/engine-router.node-test.mjs scripts/browser-automation/horizon-webclient-gate.node-test.mjs scripts/browser-automation/acceptance-gate.node-test.mjs scripts/browser-automation/audit-recovery.node-test.mjs deploy/edge-native-rebind/install.node-test.mjs scripts/browser-automation/background-ax-policy.node-test.mjs scripts/browser-automation/extension-dom-policy.node-test.mjs",
    "test:browser:reinforcement": "node --test scripts/browser-automation/reinforcement-eval.node-test.mjs && node scripts/browser-automation/reinforcement-eval.mjs",
    "browser:agent-preflight": "node scripts/browser-automation/agent-preflight.mjs",
    "test:browser:native-parity": "node --test mac-host/native-targeting.node-test.mjs mac-host/native-ax-provider.node-test.mjs mac-host/bridge.node-test.mjs mac-host/native.node-test.mjs",
    "ops:storage": "node scripts/ops/storage-alert.mjs",
    "test:ops:storage": "node --test scripts/ops/storage-alert.node-test.mjs",
    "test:ops:ssd-migration": "node --test scripts/ssd-migration/*.node-test.mjs",
    "test:adversarial:light": "npm run lint && npm run typecheck && npm run test:mac && npm run test:browser:policy && npm run test:ops:storage",
    "test:mac:isolated": "node --test mac-host/isolated-desktop/*.node-test.mjs",
    "test:mac:same-background": "node --test mac-host/same-mac-ax/*.node-test.mjs",
    "test:cli:v3": "node --test scripts/sandbox-v3-cli/*.node-test.mjs",
    "test:gemini:mcp": "node --test scripts/gemini-mcp/*.node-test.mjs",
    "test:browser:dom": "CUA_DOM_E2E=1 node mac-host/browser-dom/extension-e2e.mjs",
    "test:browser:dom:ckeditor": "CUA_DOM_E2E=1 CUA_CKEDITOR_E2E=1 node mac-host/browser-dom/extension-e2e.mjs",
    "test:task-scoped": "node --test mac-host/task-delegation.node-test.mjs deploy/task-scoped/*.node-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "playwright-core": "1.64.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  }
}
