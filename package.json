{
  "name": "cloud-sandbox-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Remote MCP server that gives ChatGPT a persistent, VM-like persistent agent workstation with nested Docker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run validate:lock && npm run lint && npm run typecheck && npm test && npm run test:mac && npm run build",
    "validate:lock": "node scripts/validate-lockfile.mjs",
    "test:mac": "node --test mac-host/*.node-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  }
}
